{
  "name": "scentdream",
  "private": true,
  "version": "1.0.0",
  "main": "main.cjs", 
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kingssx72/ScentDream.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "empaquetar": "vite build && electron-builder --publish always" 
  },
  "build": {
    "appId": "com.scentdream.app",
    "productName": "ScentDream",
    "publish": [{
      "provider": "github",
      "owner": "Kingssx72",
      "repo": "ScentDream"
    }],
    "files": [
      "dist/**/*",
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.11.1",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.8"
  }
}